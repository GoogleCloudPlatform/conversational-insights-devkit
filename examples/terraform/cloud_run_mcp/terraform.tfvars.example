project_id        = "my-gcp-project"
region            = "us-central1"
insights_location = "us-central1"
service_name      = "cxidk-mcp"
container_image   = "us-central1-docker.pkg.dev/my-gcp-project/cxidk/cxidk-mcp:2.0.0"

# Configure IAP audience (recommended behind External Application LB + IAP)
# or oauth_audience for direct OIDC Bearer verification:
iap_audience = "/projects/123456789012/locations/us-central1/services/cxidk-mcp"

# Explicit authenticated callers allowed to invoke Cloud Run:
invoker_members = [
  "serviceAccount:adk-agent-sa@my-gcp-project.iam.gserviceaccount.com",
]

allow_writes = false
